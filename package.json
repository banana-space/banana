{
  "name": "banana-space",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "api": "node --max-old-space-size=512 scripts/api.mjs",
    "check": "node scripts/check.mjs",
    "bench": "node scripts/bench.mjs",
    "compare": "node scripts/compare.mjs",
    "test": "node --test --test-reporter=./tests/helpers/reporter.mjs tests/*.mjs packages/bananamark/test/index.mjs packages/bananamark-codemirror/test/index.mjs packages/bananamark-tikz/test/tikz.mjs",
    "format": "node scripts/format.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "codemirror": "^6.0.2",
    "entities": "8.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "23.2.0",
    "katex": "0.18.4",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "pinyin-pro": "^3.29.4",
    "sass": "^1.105.1",
    "yaml": "^2.9.1"
  }
}

{{- /* Pages for the search index; postbuild reads titles and structure from the HTML itself. */ -}}
{{- $pages := slice -}}
{{- range site.Pages -}}
  {{- $page := . -}}
  {{- $kind := "" -}}
  {{- if and (eq .Kind "term") (eq .Data.Plural "categories") -}}
    {{- $kind = "category" -}}
  {{- else if and .Params.structuredPage (ne .Params.search false) (or (eq .Kind "page") .Params.collectionRoot) -}}
    {{- $kind = cond (isset .Params "wikiname") "wiki" (.Params.collectionKind | default "page") -}}
  {{- end -}}
  {{- with $kind -}}
    {{- $pages = $pages | append (dict
      "url" $page.RelPermalink
      "kind" .
      "readings" ($page.Params.searchReadings | default slice)
      "aliases" ($page.Params.wikiAliases | default slice)
      "categories" ($page.Params.directCategories | default slice)
    ) -}}
  {{- end -}}
{{- end -}}
{{- dict "base" (urls.Parse site.BaseURL).Path "language" site.Language.Lang "pages" $pages | jsonify -}}
